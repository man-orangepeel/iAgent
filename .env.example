# ══════════════════════════════════════════════════
# iAgent — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# ══════════════════════════════════════════════════

# ── Telegram ──────────────────────────────────────
# Token du bot (créé via @BotFather)
IAGENT_BOT_TOKEN=

# Chat ID autorisé (ton chat_id Telegram)
# Obtenir via @userinfobot
IAGENT_CHAT_ID=

# ── Google (via gog CLI) ──────────────────────────
# Configuré automatiquement par : gog auth login
# Ne pas remplir manuellement — géré par gog

# ── ntfy (notifications push) ─────────────────────
# Topic ntfy.sh pour les alertes
# Créer sur https://ntfy.sh
NTFY_TOPIC=

# ── Configuration optionnelle ─────────────────────
# Chemin Python (défaut auto-détecté)
# PYTHON_PATH=/usr/bin/python3

# Répertoire iAgent (défaut: ~/.iagent)
# IAGENT_DIR=/Users/tonuser/.iagent
