{
  "session": {
    "ttl_hours": 4,
    "max_size_kb": 200
  },
  "heartbeat": {
    "interval_minutes": 120,
    "timeout_seconds": 60,
    "alert_on_consecutive_failures": 2
  },
  "context": {
    "max_chars": 38000,
    "warn_threshold": 0.9
  },
  "python_path": "/Library/Frameworks/Python.framework/Versions/3.14/bin/python3",
  "gateway": {
    "tools": ["WebSearch", "Bash"],
    "timeout": 90
  },
  "tmp": {
    "audio_dir": "tmp/audio",
    "documents_dir": "tmp/documents",
    "workspace_dir": "data/workspace",
    "max_age_hours": 24,
    "purge_on_startup": true
  },
  "personal_assistant": {
    "reminder_interval_min": 15,
    "default_reminder_min": 60,
    "renotify_max_days": 7,
    "chat_id_env_var": "IAGENT_CHAT_ID"
  }
}
